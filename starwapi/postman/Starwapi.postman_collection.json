{
    "info":  {
                 "description":  "Importa la colección y un entorno. Ejecuta Login administrador, Sincronizar SWAPI, Registrar usuario y Login usuario; luego consulta el catálogo. Los logins guardan los tokens en el entorno activo. La sincronización puede tardar y requiere conexión a SWAPI. Solo se incluyen endpoints realmente expuestos por los controladores.",
                 "name":  "Starwapi API",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Autenticación",
                     "item":  [
                                  {
                                      "name":  "Registrar usuario",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "url":  "{{baseUrl}}/api/auth/register",
                                                      "description":  "Crea un usuario USER. Repetir el registro devuelve 409.",
                                                      "auth":  {
                                                                   "type":  "noauth"
                                                               },
                                                      "body":  {
                                                                   "raw":  "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               }
                                                  },
                                      "response":  [

                                                   ]
                                  },
                                  {
                                      "name":  "Login usuario",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "url":  "{{baseUrl}}/api/auth/login",
                                                      "description":  "Guarda accessToken automáticamente en token del entorno activo.",
                                                      "auth":  {
                                                                   "type":  "noauth"
                                                               },
                                                      "body":  {
                                                                   "raw":  "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               }
                                                  },
                                      "response":  [

                                                   ],
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.environment.unset(\u0027token\u0027);"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "prerequest"
                                                    },
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Login correcto\u0027, function () { pm.response.to.have.status(200); });",
                                                                                    "if (pm.response.code === 200) {",
                                                                                    "  const data = pm.response.json();",
                                                                                    "  pm.test(\u0027Token Bearer recibido\u0027, function () { pm.expect(data.tokenType).to.eql(\u0027Bearer\u0027); pm.expect(data.accessToken).to.be.a(\u0027string\u0027).and.not.empty; });",
                                                                                    "  pm.environment.set(\u0027token\u0027, data.accessToken);",
                                                                                    "}"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "test"
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Login administrador",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "url":  "{{baseUrl}}/api/auth/login",
                                                      "description":  "Mismo endpoint de login con las credenciales del administrador inicial. Guarda adminToken.",
                                                      "auth":  {
                                                                   "type":  "noauth"
                                                               },
                                                      "body":  {
                                                                   "raw":  "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               }
                                                  },
                                      "response":  [

                                                   ],
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.environment.unset(\u0027adminToken\u0027);"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "prerequest"
                                                    },
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Login correcto\u0027, function () { pm.response.to.have.status(200); });",
                                                                                    "if (pm.response.code === 200) {",
                                                                                    "  const data = pm.response.json();",
                                                                                    "  pm.test(\u0027Token Bearer recibido\u0027, function () { pm.expect(data.tokenType).to.eql(\u0027Bearer\u0027); pm.expect(data.accessToken).to.be.a(\u0027string\u0027).and.not.empty; });",
                                                                                    "  pm.environment.set(\u0027adminToken\u0027, data.accessToken);",
                                                                                    "}"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "test"
                                                    }
                                                ]
                                  }
                              ]
                 },
                 {
                     "name":  "Administración",
                     "item":  [
                                  {
                                      "name":  "Sincronizar SWAPI",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [

                                                                 ],
                                                      "url":  "{{baseUrl}}/api/admin/sync",
                                                      "description":  "Importa personajes, películas, vehículos y naves. Requiere ADMIN. Se ejecuta manualmente; puede tardar varios minutos.",
                                                      "auth":  {
                                                                   "bearer":  [
                                                                                  {
                                                                                      "key":  "token",
                                                                                      "type":  "string",
                                                                                      "value":  "{{adminToken}}"
                                                                                  }
                                                                              ],
                                                                   "type":  "bearer"
                                                               }
                                                  },
                                      "response":  [

                                                   ]
                                  }
                              ]
